# Personal direnv overrides for pynetappfoundry
# Copy this file to .envrc.local and customize as needed
# .envrc.local is git-ignored and will not be committed

# Example: Use a different config directory for nf CLI
# export NF_CONFIG_DIR="/path/to/my/config"

# Example: Enable debug mode
# export DEBUG=true

# Example: Set log level
# export LOG_LEVEL=DEBUG

# Example: Custom API endpoint for testing
# export ONTAP_API_URL=https://your-test-cluster.local

# Example: Override cache directories
# export UV_CACHE_DIR="$HOME/.cache/uv"
# export RUFF_CACHE_DIR="$HOME/.cache/ruff"
# export MYPY_CACHE_DIR="$HOME/.cache/mypy"
# export COVERAGE_FILE="$HOME/.cache/coverage/.coverage"
# export PRE_COMMIT_HOME="$HOME/.cache/pre-commit"

# Example: Editor and browser
# export EDITOR=nvim
# export BROWSER=firefox

# Example: Enable LSP tool for Claude Code (see .claude/lsp-setup.md)
# export ENABLE_LSP_TOOL=1

# Example: Pyright debug logging (for LSP troubleshooting)
# export PYRIGHT_PYTHON_DEBUG=1
